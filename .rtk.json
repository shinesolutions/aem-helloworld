{
  "tagFormat": "aem-helloworld-{version}",
  "resources": [
    {
      "path": "pom.xml",
      "type": "text",
      "params": {
        "regex": "(?<=<artifactId>aem-helloworld</artifactId>\\s*<version>)[^<]+"
      }
    },
    {
      "path": "bundle/pom.xml",
      "type": "text",
      "params": {
        "regex": "(?<=<artifactId>aem-helloworld</artifactId>\\s*<version>)[^<]+"
      }
    },
    {
      "path": "content/pom.xml",
      "type": "text",
      "params": {
        "regex": "(?<=<artifactId>aem-helloworld</artifactId>\\s*<version>)[^<]+"
      }
    },
    {
      "path": "CHANGELOG.md",
      "type": "keep-a-changelog"
    }
  ]
}
